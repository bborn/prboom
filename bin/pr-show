#!/usr/bin/env bash
# pr-show FILE[:LINE] [CONTEXT]
#
# Renders one piece of code for a passive review pane: never pages, never takes
# the keyboard, clears first so the pane shows one thing at a time.
#
# What you get depends on what is useful, not on what is technically a diff:
#
#   file added by the PR   syntax-highlighted source. A new file rendered as a
#                          diff is a wall of green that says nothing.
#   changed file + LINE    only the hunks near that line.
#   changed file, no LINE  the whole file's diff.
#   untouched file         the source, centred on LINE.
#
# CONTEXT is lines either side (default 30). Base comes from
# .git/pr-review-base, else origin/main, else HEAD. PR_BASE overrides.
set -o pipefail

# shellcheck source=bin/prboom-env
. "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/prboom-env"

ref="${1:-}"
[ -z "$ref" ] && { echo "usage: pr-show FILE[:LINE] [CONTEXT]" >&2; exit 2; }
ctx="${2:-30}"

file="${ref%%:*}"
line=""
case "$ref" in *:*) line="${ref##*:}" ;; esac
case "$line" in ''|*[!0-9]*) line="" ;; esac

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pr-show: not inside a git repository" >&2; exit 1; }

if [ -f "$root/$file" ]; then rel="$file"
elif [ -f "$file" ]; then
  rel=$(python3 -c 'import os,sys;print(os.path.relpath(os.path.realpath(sys.argv[1]),sys.argv[2]))' "$file" "$root")
else
  rel=$(git -C "$root" ls-files "*${file}" 2>/dev/null | head -1)
fi
[ -z "$rel" ] && { echo "pr-show: cannot find $file" >&2; exit 1; }

base="${PR_BASE:-}"
if [ -z "$base" ]; then
  recorded="$(git -C "$root" rev-parse --path-format=absolute --git-dir)/pr-review-base"
  if [ -r "$recorded" ]; then base=$(cat "$recorded")
  elif git -C "$root" rev-parse --verify -q origin/main >/dev/null; then base="origin/main"
  else base="HEAD"; fi
fi
case "$base" in HEAD) range="HEAD" ;; *..*) range="$base" ;; *) range="${base}..." ;; esac

# This pane's width. tput asks our own tty, so it is right even when another
# pane is the active one. Bare `tmux display-message` is not: with no -t it
# answers for the ACTIVE pane, and since this script runs in the passive Shell
# pane while you type in the agent pane, it reported the agent pane's width and
# delta emitted lines too wide to fit, which the terminal then wrapped raggedly.
cols=$(tput cols 2>/dev/null)
if [ -z "${cols:-}" ] && [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
  cols=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_width}' 2>/dev/null)
fi
[ -z "${cols:-}" ] && cols=120

# Delta's stock plus/minus styles fill the whole line with saturated colour, so
# a diff reads as a block of green rather than as code. These keep the real
# syntax highlighting as the foreground and use a dark tint behind it, with the
# brighter emph tint only on the part of the line that actually differs.
#
# Override any of it with PR_DELTA_OPTS, e.g.
#   PR_DELTA_OPTS='--plus-style "syntax #1a3a24"'
DELTA_STYLE=(
  --minus-style      "syntax #2d1416"
  --minus-emph-style "syntax #5a2124"
  --plus-style       "syntax #0f2a18"
  --plus-emph-style  "syntax #1c5232"
  --zero-style       "syntax"
)

render_diff() {  # stdin: a diff
  if command -v delta >/dev/null 2>&1; then
    # The file header is omitted because this script already printed one, and
    # in a half-width pane delta's box drawing costs six lines before any code.
    # shellcheck disable=SC2086
    delta --paging=never --line-numbers --hyperlinks \
      --hyperlinks-file-link-format "file://{path}#{line}" \
      --file-style=omit --hunk-header-decoration-style=none \
      --wrap-max-lines 2 --width "$cols" \
      "${DELTA_STYLE[@]}" ${PR_DELTA_OPTS:-}
  else
    cat
  fi
}

render_source() {  # $1 from, $2 to (0 = whole file)
  if command -v bat >/dev/null 2>&1; then
    if [ "$2" -gt 0 ]; then
      bat --style=numbers --color=always --paging=never --terminal-width "$cols" \
        ${line:+-H "$line"} -r "$1:$2" "$root/$rel"
    else
      bat --style=numbers --color=always --paging=never --terminal-width "$cols" "$root/$rel"
    fi
  else
    if [ "$2" -gt 0 ]; then
      sed -n "$1,$2p" "$root/$rel" | nl -ba -v "$1" -w6 -s'  '
    else
      nl -ba -w6 -s'  ' "$root/$rel"
    fi
  fi
}

from=1; to=0
if [ -n "$line" ]; then
  from=$(( line - ctx )); [ "$from" -lt 1 ] && from=1
  to=$(( line + ctx ))
fi

status=$(git -C "$root" diff --name-status "$range" -- "$rel" 2>/dev/null | cut -f1)

clear
case "$status" in
  A)  printf '\033[2m%s  ·  new in this PR\033[0m\n\n' "$rel"
      render_source "$from" "$to" ;;
  "") printf '\033[2m%s  ·  not touched by this PR\033[0m\n\n' "$rel"
      render_source "$from" "$to" ;;
  *)  if [ -n "$line" ]; then
        printf '\033[2m%s  ·  changed  ·  around line %s\033[0m\n\n' "$rel" "$line"
        # Keep only the hunks whose new-side range overlaps the window.
        git -C "$root" diff "$range" -- "$rel" | awk -v lo="$from" -v hi="$to" '
          /^diff --git/ { hdr = $0 "\n"; keep = 0; next }
          /^(index |--- |\+\+\+ |old mode|new mode|similarity|rename )/ { hdr = hdr $0 "\n"; next }
          /^@@/ {
            match($0, /\+[0-9]+(,[0-9]+)?/)
            split(substr($0, RSTART + 1, RLENGTH - 1), a, ",")
            s = a[1] + 0; n = (a[2] == "" ? 1 : a[2] + 0); e = s + n - 1
            keep = (s <= hi && e >= lo)
            if (keep && !shown) { printf "%s", hdr; shown = 1 }
          }
          { if (keep) print }
        ' | render_diff
      else
        printf '\033[2m%s  ·  changed\033[0m\n\n' "$rel"
        git -C "$root" diff "$range" -- "$rel" | render_diff
      fi ;;
esac
