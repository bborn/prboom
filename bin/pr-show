#!/usr/bin/env bash
# pr-show FILE[:LINE] [CONTEXT]
#
# Puts code in the code pane beside the agent: the lines around LINE with the
# PR's changes in place, or the file's diff when there is no line. CONTEXT is
# lines either side, default 30.
#
# The pane is `prboom view`. This only tells it what to show, through a file in
# the worktree's git dir, so nothing is typed into a shell. If the Shell pane
# is sitting at a prompt, the first call turns it into the code pane.
exec prboom show "$@"
