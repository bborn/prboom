#!/usr/bin/env bash
# pr-pane [COMMAND...]
#
# With no arguments: print the id of this task's Shell pane.
# With arguments: run that command in the Shell pane.
#
# The agent runs in pane 0 of a TaskYou task window; pane 1 is the shell. This
# finds it by title, falling back to "the other pane", so an agent can put code
# in front of the human without knowing the layout.
set -o pipefail

[ -z "${TMUX:-}" ] && { echo "pr-pane: not inside tmux" >&2; exit 1; }

me="${TMUX_PANE:-}"
[ -z "$me" ] && { echo "pr-pane: TMUX_PANE is unset" >&2; exit 1; }
# Resolve the caller's own window. Without -t, tmux answers for whichever
# window is active, which sends keys into another task's session.
win=$(tmux display-message -t "$me" -p '#{session_name}:#{window_index}') || exit 1

target=$(tmux list-panes -t "$win" -F '#{pane_id}	#{pane_title}' \
  | awk -F'\t' '$2 == "Shell" { print $1; exit }')

if [ -z "$target" ]; then
  target=$(tmux list-panes -t "$win" -F '#{pane_id}' | grep -v -x -- "$me" | head -1)
fi
[ -z "$target" ] && { echo "pr-pane: no second pane in $win" >&2; exit 1; }

if [ $# -eq 0 ]; then
  printf '%s\n' "$target"
  exit 0
fi

# Interrupt whatever is up, then send the command. No focus change: the human
# keeps typing to the agent.
tmux send-keys -t "$target" C-c 2>/dev/null
tmux send-keys -t "$target" "$*" Enter
