#!/usr/bin/env bash
# pr-open NUMBER [-R OWNER/REPO]
#
# Opens a PR for walking, using nothing but git and tmux: a worktree for the
# PR's branch, a session with the agent on the left and a Shell pane on the
# right, and the agent started on /pr-walk.
#
# Safe to run again on the same PR. Running it twice takes you back to the
# session you left, and never resets a worktree that has work in it.
#
# TaskYou is optional (see pr-task) and only adds board tracking; it builds the
# same two-pane shape, which is why the skill works under either.
set -euo pipefail
export GIT_PAGER=cat PAGER=cat

# shellcheck source=bin/prboom-env
. "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/prboom-env"

num="${1:-}"
[ -z "$num" ] && { echo "usage: pr-open NUMBER [-R OWNER/REPO]" >&2; exit 2; }
shift

sess="pr-$num"

go_there() {
  if [ -n "${TMUX:-}" ]; then exec tmux switch-client -t "$sess"
  else exec tmux attach -t "$sess"; fi
}

# Already open: go back to it and touch nothing else. No fetch, no checkout,
# no reset — you may be mid-edit in there.
if tmux has-session -t "=$sess" 2>/dev/null; then
  echo "→ PR #$num is already open"
  go_there
fi

common=$(git rev-parse --path-format=absolute --git-common-dir)
main=$(dirname "$common")
repo=$(basename "$main")

meta=$(gh pr view "$num" "$@" --json title,baseRefName,url)
base=$(printf '%s' "$meta" | jq -r .baseRefName)
url=$(printf '%s' "$meta" | jq -r .url)

branch="pr/$num"
wt="$PR_WORKTREE_ROOT/$repo/pr-$num"

# Fetch to a ref under refs/prboom/, never straight into refs/heads/. Git
# refuses to fetch into a branch that is checked out in any worktree, so
# fetching into pr/<n> breaks the moment this PR has been opened once before.
# refs/pull/N/head also resolves for forks, unlike origin/<headRefName>.
git -C "$main" fetch -q --force origin "refs/pull/$num/head:refs/prboom/$num"
head=$(git -C "$main" rev-parse "refs/prboom/$num")

git -C "$main" fetch -q origin "$base" 2>/dev/null || true
if git -C "$main" rev-parse --verify -q "origin/$base" >/dev/null; then
  ref="origin/$base"
else
  ref="$base"
fi

resume=0
git -C "$main" worktree prune

if [ -d "$wt" ]; then
  resume=1
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    # Uncommitted work from a previous pass. Resetting here would delete the
    # fixes you already made, which is the opposite of reopening.
    echo "→ PR #$num: keeping the worktree as it is, it has uncommitted changes"
  elif [ "$(git -C "$wt" rev-parse HEAD)" != "$head" ]; then
    git -C "$wt" checkout -q -B "$branch" "$head"
    echo "→ PR #$num: worktree moved up to the current head"
  fi
else
  git -C "$main" worktree add -q -B "$branch" "$wt" "$head"
fi

gitdir=$(git -C "$wt" rev-parse --path-format=absolute --git-dir)
printf '%s\n' "$ref" > "$gitdir/pr-review-base"

# A worktree is a path mise has never seen, so its config is untrusted and every
# command in both panes prints a warning about it. The file is the repo's own,
# already trusted wherever the repo lives.
if command -v mise >/dev/null 2>&1; then
  for cfg in "$wt/mise.toml" "$wt/.mise.toml" "$wt/.config/mise/config.toml"; do
    [ -r "$cfg" ] && mise trust "$cfg" >/dev/null 2>&1
  done
fi

# Claude keys its history off the directory, with / and . flattened to -.
hist="$HOME/.claude/projects/$(printf '%s' "$wt" | tr '/.' '--')"
if [ "$resume" = 1 ] && ls "$hist"/*.jsonl >/dev/null 2>&1; then
  agent=("$PR_AGENT" --continue)
  echo "→ resuming the previous conversation"
else
  agent=("$PR_AGENT" "$PR_SKILL

Walk PR #$num one finding at a time.
$url")
fi

shell="${SHELL:-/bin/zsh}"

# Its own session, even when called from inside tmux: review sessions stay
# separate (tmux ls lists them, detach and reattach work), and the mouse
# setting below applies here and nowhere else.
tmux new-session -d -s "$sess" -c "$wt" "${agent[@]}"
tmux split-window -h -t "$sess:0.0" -c "$wt" "$shell"
tmux select-pane -t "$sess:0.0" -T Agent
tmux select-pane -t "$sess:0.1" -T Shell
tmux select-pane -t "$sess:0.0"

# Click a pane to focus it, wheel to scroll it. Without this you need
# ctrl-b arrow and ctrl-b [ , which is a lot to know for a review tool.
tmux set-option -t "$sess" mouse on

go_there
