#!/usr/bin/env bash
# pr-open NUMBER [-R OWNER/REPO]
#
# Opens a PR for walking, using nothing but git and tmux: a worktree for the
# PR's branch, a tmux window with the agent on the left and a Shell pane on the
# right, and the agent started on /pr-walk.
#
# This is the whole dependency story. TaskYou is optional (see pr-task) and only
# adds board tracking; it provides the same two-pane shape, which is why the
# skill works under either.
set -euo pipefail
export GIT_PAGER=cat PAGER=cat

num="${1:-}"
[ -z "$num" ] && { echo "usage: pr-open NUMBER [-R OWNER/REPO]" >&2; exit 2; }
shift

common=$(git rev-parse --path-format=absolute --git-common-dir)
main=$(dirname "$common")
repo=$(basename "$main")

meta=$(gh pr view "$num" "$@" --json title,baseRefName,url)
title=$(printf '%s' "$meta" | jq -r .title)
base=$(printf '%s' "$meta" | jq -r .baseRefName)
url=$(printf '%s' "$meta" | jq -r .url)

branch="pr/$num"
wt="${PR_WORKTREE_ROOT:-$HOME/.t3/worktrees}/$repo/pr-$num"

# Fetch to a ref under refs/prboom/, never straight into refs/heads/. Git
# refuses to fetch into a branch that is checked out in any worktree, so
# fetching into pr/<n> breaks the moment this PR has been opened once before.
# refs/pull/N/head also resolves for forks, unlike origin/<headRefName>.
git -C "$main" fetch -q --force origin "refs/pull/$num/head:refs/prboom/$num"
head=$(git -C "$main" rev-parse "refs/prboom/$num")

git -C "$main" fetch -q origin "$base" 2>/dev/null || true
if git -C "$main" rev-parse --verify -q "origin/$base" >/dev/null; then
  ref="origin/$base"
else
  ref="$base"
fi

git -C "$main" worktree prune
if [ -d "$wt" ]; then
  # -B moves the branch onto the new head even when this worktree holds it.
  git -C "$wt" checkout -q -B "$branch" "$head"
else
  git -C "$main" worktree add -q -B "$branch" "$wt" "$head"
fi

gitdir=$(git -C "$wt" rev-parse --path-format=absolute --git-dir)
printf '%s\n' "$ref" > "$gitdir/pr-review-base"

prompt="/pr-walk

Walk PR #$num one finding at a time with the pr-walk skill.
$url"

win="pr-$num"
shell="${SHELL:-/bin/zsh}"

if [ -n "${TMUX:-}" ]; then
  tmux new-window -n "$win" -c "$wt" claude "$prompt"
  tmux split-window -h -t "$win.0" -c "$wt" "$shell"
  tmux select-pane -t "$win.0" -T Agent
  tmux select-pane -t "$win.1" -T Shell
  tmux select-pane -t "$win.0"
else
  tmux new-session -d -s "$win" -c "$wt" claude "$prompt"
  tmux split-window -h -t "$win:0.0" -c "$wt" "$shell"
  tmux select-pane -t "$win:0.0" -T Agent
  tmux select-pane -t "$win:0.1" -T Shell
  tmux select-pane -t "$win:0.0"
  exec tmux attach -t "$win"
fi
